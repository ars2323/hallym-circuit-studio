{"method":"edit.addComponent","lib":"Gates","name":"AND Gate","loc":[260,600],"as":"and3again"}
{"method":"edit.addComponent","lib":"Gates","name":"OR Gate","loc":[260,260],"attrs":{"facing":"north","inputs":"4"},"as":"or4"}
{"method":"edit.addComponent","lib":"Gates","name":"NOT Gate","loc":[340,100],"attrs":{"facing":"west"},"as":"not"}
{"method":"edit.addComponent","lib":"Gates","name":"XOR Gate","loc":[260,380],"attrs":{"inputs":"2","size":"30"},"as":"xor"}
{"method":"edit.addComponent","lib":"Gates","name":"NAND Gate","loc":[260,500],"attrs":{"facing":"south","inputs":"2","negate0":"true"}}
{"method":"edit.addComponent","lib":"Wiring","name":"Pin","loc":[560,100],"attrs":{"facing":"west","output":"true","width":"16","label":"Y"},"as":"pinY"}
{"method":"edit.addComponent","lib":"Wiring","name":"Constant","loc":[400,200],"attrs":{"width":"4","value":"0xa"}}
{"method":"edit.addComponent","lib":"Plexers","name":"Multiplexer","loc":[440,380],"attrs":{"select":"2","width":"8"},"as":"mux"}
{"method":"edit.addComponent","lib":"Memory","name":"Register","loc":[600,380],"attrs":{"width":"16","label":"PC"}}
