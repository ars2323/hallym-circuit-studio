# Hallym MIPS v2.4.0 golden space-gap.s: registers and console output at exit.
# Oracle: SPIM 9.1.24 (vendor/spim-9.1.24; its CPU/ is byte-identical to Hallym MIPS v2.4.0's CPU/).
# Made by: spim -exception in an empty environment with the commands load "space-gap.s", run, print_all_regs hex (no program arguments).
# $sp and the start-up code's $a0-$a2 come from the run stack: with no arguments $sp is 0x7ffffff0; Hallym MIPS passes the file name, so its reg $sp is 0x7fffffe4.
# Made and checked against SPIM at commit 5bde1ea (D-138). Frozen before vendor/spim-9.1.24 was removed (D-141): this file is the oracle.
$zero 00000000
$at 10010000
$v0 0000000a
$v1 00000000
$a0 00000000
$a1 7ffffff4
$a2 7ffffff8
$a3 00000000
$t0 10010004
$t1 0000007f
$t2 22222222
$t3 00000000
$t4 00000000
$t5 00000000
$t6 00000000
$t7 00000000
$s0 00000000
$s1 00000000
$s2 00000000
$s3 00000000
$s4 00000000
$s5 00000000
$s6 00000000
$s7 00000000
$t8 00000000
$t9 00000000
$k0 00000000
$k1 00000000
$gp 10008000
$sp 7ffffff0
$fp 00000000
$ra 00400018
hi 00000000
lo 00000000
console ""
